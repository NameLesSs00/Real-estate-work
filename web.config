<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <modules>
            <remove name="WebDAVModule" />
        </modules>
        <handlers>
            <!-- Removes WebDAV to allow PUT and DELETE requests -->
            <remove name="WebDAV" />
            <!-- Removes the default static file handler to prevent 403 Forbidden errors -->
            <remove name="StaticFile" />
            <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" requireAccess="Script" />
        </handlers>
        <httpPlatform processPath="node" arguments="app.js" startupTimeLimit="40" startupRetryCount="2" stdoutLogEnabled="true" stdoutLogFile="./log.txt">
            <environmentVariables>
                <environmentVariable name="PORT" value="%HTTP_PLATFORM_PORT%" />
                <environmentVariable name="NODE_ENV" value="production" />
            </environmentVariables>
        </httpPlatform>
    </system.webServer>
</configuration>