<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!-- Tell IIS to handle requests via iisnode, pointing to our custom server -->
    <handlers>
      <add name="iisnode" path="server.js" verb="*" modules="iisnode" />
    </handlers>

    <rewrite>
      <rules>
        <!-- Do not rewrite requests for static files in /public -->
        <rule name="StaticFiles" stopProcessing="true">
          <match url="^(assists|_next|favicon\.ico)(.*)" />
          <action type="None" />
        </rule>
        <!-- Route all other requests to server.js -->
        <rule name="DynamicContent">
          <match url="/*" />
          <action type="Rewrite" url="server.js" />
        </rule>
      </rules>
    </rewrite>

    <iisnode
      node_env="production"
      nodeProcessCommandLine="node"
      loggingEnabled="true"
      logDirectory="iisnode"
      debuggingEnabled="false"
    />

    <!-- Return 404 for directories to avoid directory listing -->
    <directoryBrowse enabled="false" />
  </system.webServer>
</configuration>
